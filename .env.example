# Copy this file to .env and adjust values for your setup:
#   cp .env.example .env

# Backend API (Express): MongoDB connection string
# Use mongodb://mongo:27017/timeline_db inside Docker, or localhost when running locally
MONGO_URI="mongodb://mongo:27017/timeline_db"

# Statistics service (Quarkus): MongoDB connection settings
MONGO_CONNECTION_STRING=mongodb://mongo:27017
MONGO_DATABASE=timeline_db

# Optional: default user ID for the frontend auto-login (prevents Guest mode)
# Set it in frontend-v2/.env.local instead if you don't want it in the shared .env
# NEXT_PUBLIC_DEFAULT_USER_ID=1